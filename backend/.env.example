PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/project_next

# Ollama Cloud — no local GPU/server needed, inference runs on Ollama's servers.
# Create a key at https://ollama.com/settings/keys
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=your_ollama_cloud_api_key_here

# Use cloud catalog model ids (not local pull names) — check your current
# catalog at https://ollama.com/library?cloud for what's available.
OLLAMA_REASONING_MODEL=gpt-oss:120b
OLLAMA_COPY_MODEL=gpt-oss:120b
OLLAMA_VISION_MODEL=qwen3-vl
